# Copy to ../.env and fill in (used by ops/docker-compose.yml)
DOMAIN=calendar.example.com
POSTGRES_PASSWORD=change-me-to-a-long-random-string
LOG_LEVEL=info
# Backups: keep the newest N daily dumps and the first dump of each of the last N months
KEEP_DAILY=30
KEEP_MONTHLY=12
# Optional off-site copy (any S3-compatible storage). Leave empty to keep backups on the local volume only.
S3_BUCKET=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
